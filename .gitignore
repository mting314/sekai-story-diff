# Asset caches and rendered output: ~1.8 GB, all reproducible from the CDN.
/data/*
# ...but the pipeline's own findings are small and are the input to every later
# stage, so they are tracked. Without them CI has nothing to work from.
!/data/versions_en.json
!/data/versions_etag.json
!/data/last_checked.txt
!/data/fingerprints.json
!/data/transitions.json
!/data/transitions/
!/data/official_changes*.json
__pycache__/
*.pyc
.venv/

# staged copies of the fork's files; the patch is the artifact
port/live2d-version-diff/
.DS_Store

# vite app: node_modules and build output. The sprites and payload ARE committed:
# CI cannot regenerate them (needs Cubism Core, a GL context and ~1 GB of asset
# cache), so the build input has to be in the tree.
web/node_modules/
web/dist/

# project venv
.venv/

# probe output
spike-*.png
