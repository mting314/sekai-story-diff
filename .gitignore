# Asset caches and rendered output: ~1.8 GB, all reproducible from the CDN.
/data/*
# ...but the pipeline's own findings are small and are the input to every later
# stage, so they are tracked. Without them CI has nothing to work from.
!/data/versions_en.json
!/data/versions_etag.json
!/data/last_checked.txt
!/data/fingerprints.json
!/data/transitions.json
!/data/transitions/
!/data/official_changes*.json
# The master DB snapshot. Nothing downloads it and every script reads it, so CI has
# none unless it is tracked. Only the four the pipeline actually opens: cards.json
# (34 MB) and events_jp.json serve the portrait gallery, not the site.
!/data/master/
/data/master/*
!/data/master/eventStories.json
!/data/master/eventStories_en.json
!/data/master/events_en.json
!/data/master/character2ds.json
__pycache__/
*.pyc
.venv/

# staged copies of the fork's files; the patch is the artifact
port/live2d-version-diff/
.DS_Store

# vite app: node_modules and build output. The sprites and payload ARE committed:
# CI cannot regenerate them (needs Cubism Core, a GL context and ~1 GB of asset
# cache), so the build input has to be in the tree.
node_modules/
web/dist/

# project venv
.venv/

# probe output
spike-*.png

# Generated media is served from gs://sekai-story-diff-assets, not from here.
# unit/ stays: those logos are a source asset copied from the viewer, not generated.
web/public/sprites/
web/public/bg/
web/public/event/
web/public/logo/
